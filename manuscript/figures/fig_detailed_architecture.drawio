<mxfile host="app.diagrams.net"><diagram name="Architecture v3"><mxGraphModel adaptiveColors="none" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Split cloud–edge forecaster with node memory (v3): data flow at inference (top) and training (bottom)" style="text;html=1;fontFamily=Times New Roman;fontSize=20;fontStyle=1;fontColor=#111111;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1500" height="30" as="geometry"/></mxCell>
<mxCell id="laneC" value="CLOUD — sees all &lt;i&gt;N&lt;/i&gt; nodes, runs every hour" style="rounded=0;html=1;fontFamily=Times New Roman;fontSize=14;fontStyle=1;fontColor=#444444;fillColor=#FAFAFA;strokeColor=#9E9E9E;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="1780" height="405" as="geometry"/></mxCell>
<mxCell id="laneE" value="EDGE NODE &lt;i&gt;i&lt;/i&gt; — ESP32, runs every hour, keeps working offline" style="rounded=0;html=1;fontFamily=Times New Roman;fontSize=14;fontStyle=1;fontColor=#2F6F62;fillColor=#F6FBFA;strokeColor=#4A9A8A;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1780" height="370" as="geometry"/></mxCell>
<mxCell id="linkT" value="WIRELESS LINK (Wi-Fi):  ↑ hourly upload from every node   ·   ↓ hourly broadcast to all nodes   ·   ↓ personal forecast to one node, only when triggered" style="text;html=1;fontFamily=Times New Roman;fontSize=13;fontStyle=2;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="476" width="760" height="28" as="geometry"/></mxCell>
<mxCell id="stack" value="" style="rounded=0;html=1;fillColor=#EEEEEE;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="150" height="340" as="geometry"/></mxCell>
<mxCell id="stT" value="Uploads of all nodes" style="text;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="150" height="20" as="geometry"/></mxCell>
<mxCell id="n1" value="node 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#111111;fillColor=#F5F5F5;gradientColor=#D9D9D9;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="65" y="130" width="100" height="36" as="geometry"/></mxCell>
<mxCell id="n2" value="node 2" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#111111;fillColor=#F5F5F5;gradientColor=#D9D9D9;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="65" y="176" width="100" height="36" as="geometry"/></mxCell>
<mxCell id="n3" value="⋮" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fontColor=#111111;fillColor=#F5F5F5;gradientColor=#D9D9D9;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="65" y="222" width="100" height="36" as="geometry"/></mxCell>
<mxCell id="n4" value="node &lt;i&gt;N&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#111111;fillColor=#F5F5F5;gradientColor=#D9D9D9;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="65" y="268" width="100" height="36" as="geometry"/></mxCell>
<mxCell id="stX" value="&lt;i&gt;X&lt;/i&gt;, &lt;i&gt;M&lt;/i&gt; ∈ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt;×24×30&lt;/sup&gt;&lt;br&gt;23 sensor + 7 ERA5 ch.,&lt;br&gt;z-scored, mask &lt;i&gt;M&lt;/i&gt;&lt;br&gt;&lt;i&gt;S&lt;/i&gt; ∈ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt;×6&lt;/sup&gt; (static)&lt;br&gt;&lt;i&gt;N&lt;/i&gt; = 27 (+5 unseen)" style="text;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="312" width="146" height="124" as="geometry"/></mxCell>
<mxCell id="xfut" value="&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;fut&lt;/sub&gt; ∈ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt;×6×9&lt;/sup&gt;: ERA5 &lt;i&gt;t&lt;/i&gt;+1..&lt;i&gt;t&lt;/i&gt;+6 (7, hindcast) + clock (2)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#F5F5F5;gradientColor=#E0E0E0;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="92" width="220" height="38" as="geometry"/></mxCell>
<mxCell id="cT" value="③b Cloud graph model TI-STGNN (T1), &lt;i&gt;d&lt;/i&gt; = 64, ≈0.2 M params" style="rounded=0;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#2B4C7E;fillColor=#F3F7FD;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="215" y="145" width="1120" height="160" as="geometry"/></mxCell>
<mxCell id="emb" value="&lt;b&gt;Embedding&lt;/b&gt;&lt;br&gt;Linear([&lt;i&gt;X&lt;/i&gt;⊙&lt;i&gt;M&lt;/i&gt;, &lt;i&gt;M&lt;/i&gt;]: 60→64)&lt;br&gt;+ Linear(&lt;i&gt;S&lt;/i&gt;: 6→64)&lt;br&gt;+ sinusoidal hour code&lt;br&gt;→ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt;×24×64&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="230" y="170" width="170" height="110" as="geometry"/></mxCell>
<mxCell id="enc" value="&lt;b&gt;Temporal encoder&lt;/b&gt; (per node)&lt;br&gt;2 × Transformer layer&lt;br&gt;4 heads, FFN 256, pre-LN,&lt;br&gt;dropout 0.1 → LayerNorm&lt;br&gt;&lt;i&gt;F&lt;/i&gt; ∈ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt;×24×64&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="gat" value="&lt;b&gt;Spatial graph attention&lt;/b&gt; (over &lt;i&gt;N&lt;/i&gt;)&lt;br&gt;&lt;i&gt;e&lt;sub&gt;ij&lt;/sub&gt;&lt;/i&gt; = LReLU(&lt;i&gt;a&lt;/i&gt;&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;⊤&lt;/sup&gt;&lt;i&gt;Wh&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; + &lt;i&gt;a&lt;/i&gt;&lt;sub&gt;s&lt;/sub&gt;&lt;sup&gt;⊤&lt;/sup&gt;&lt;i&gt;Wh&lt;sub&gt;j&lt;/sub&gt;&lt;/i&gt;)&lt;br&gt;+ &lt;i&gt;β&lt;/i&gt; log(1/&lt;i&gt;d&lt;sub&gt;ij&lt;/sub&gt;&lt;/i&gt;),  &lt;i&gt;α&lt;sub&gt;ij&lt;/sub&gt;&lt;/i&gt; = softmax&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;(&lt;i&gt;e&lt;sub&gt;ij&lt;/sub&gt;&lt;/i&gt;)&lt;br&gt;&lt;i&gt;h&lt;sub&gt;s&lt;/sub&gt;&lt;/i&gt; = &lt;i&gt;h&lt;sub&gt;t&lt;/sub&gt;&lt;/i&gt; + Linear(Σ&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;α&lt;sub&gt;ij&lt;/sub&gt; Wh&lt;sub&gt;j&lt;/sub&gt;&lt;/i&gt;)&lt;br&gt;∈ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt;×64&lt;/sup&gt;  (ADR, wind: ablation only)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="dec" value="&lt;b&gt;Decoder&lt;/b&gt; (6 hour queries)&lt;br&gt;&lt;i&gt;z&lt;/i&gt; = GLU(&lt;i&gt;W&lt;/i&gt;[&lt;i&gt;h&lt;sub&gt;s&lt;/sub&gt;&lt;/i&gt; ‖ &lt;i&gt;h&lt;sub&gt;t&lt;/sub&gt;&lt;/i&gt;]) ∈ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt;×64&lt;/sup&gt;&lt;br&gt;&lt;i&gt;q&lt;sub&gt;k&lt;/sub&gt;&lt;/i&gt; = &lt;i&gt;E&lt;sub&gt;k&lt;/sub&gt;&lt;/i&gt; + &lt;i&gt;W&lt;/i&gt;&lt;sub&gt;x&lt;/sub&gt;&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;fut,&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; + &lt;i&gt;z&lt;/i&gt;,  &lt;i&gt;k&lt;/i&gt; = 1..6&lt;br&gt;Transformer decoder layer,&lt;br&gt;cross-attends to &lt;i&gt;F&lt;/i&gt; → ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt;×6×64&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="910" y="170" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="heads" value="&lt;b&gt;Heads&lt;/b&gt;&lt;br&gt;Linear 64→2 (forecast)&lt;br&gt;Linear 64→4 (band)&lt;br&gt;&lt;i&gt;ŷ&lt;/i&gt;&lt;sup&gt;T&lt;/sup&gt;, &lt;i&gt;q&lt;/i&gt;&lt;sub&gt;10&lt;/sub&gt;, &lt;i&gt;q&lt;/i&gt;&lt;sub&gt;90&lt;/sub&gt; ∈ ℝ&lt;sup&gt;&lt;i&gt;N&lt;/i&gt;×12&lt;/sup&gt;&lt;br&gt;[PM2.5, PM10] × +1..+6 h" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1140" y="170" width="180" height="110" as="geometry"/></mxCell>
<mxCell id="cR" value="③a Regional forecaster (city-wide change)" style="rounded=0;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#8A5A00;fillColor=#FFF8EF;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="215" y="320" width="745" height="128" as="geometry"/></mxCell>
<mxCell id="sig" value="Σ/&lt;i&gt;N&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#111111;fillColor=#FFFFFF;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="232" y="372" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="tab" value="&lt;b&gt;Regional features&lt;/b&gt; &lt;i&gt;u&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;) ∈ ℝ&lt;sup&gt;36&lt;/sup&gt;&lt;br&gt;&lt;i&gt;R̄&lt;/i&gt;&lt;sub&gt;25&lt;/sub&gt;, &lt;i&gt;R̄&lt;/i&gt;&lt;sub&gt;10&lt;/sub&gt; = mean of nodes' own ln PM,&lt;br&gt;lags {0,1,2,3,6,12,23} h + Δ1h, Δ3h (18)&lt;br&gt;mean RH, T, CO, fan u, v (5) · ERA5 now (7) · clock (6)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="300" y="345" width="250" height="95" as="geometry"/></mxCell>
<mxCell id="lgb" value="&lt;b&gt;6 × LightGBM&lt;/b&gt; (one per output)&lt;br&gt;L2, 300 trees, 31 leaves&lt;br&gt;out-of-fold over 2-yr blocks&lt;br&gt;&lt;i&gt;R̂&lt;/i&gt; ∈ ℝ&lt;sup&gt;6&lt;/sup&gt;: city-mean Δ ln(1+PM),&lt;br&gt;[PM2.5, PM10] × +1..+3 h" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="580" y="345" width="200" height="95" as="geometry"/></mxCell>
<mxCell id="pkt" value="&lt;b&gt;④ Broadcast packet&lt;/b&gt;&lt;br&gt;[&lt;i&gt;R̂&lt;/i&gt; ∈ ℝ&lt;sup&gt;6&lt;/sup&gt; ‖ &lt;i&gt;R̄&lt;/i&gt;&lt;sub&gt;25&lt;/sub&gt;(&lt;i&gt;t&lt;/i&gt;), &lt;i&gt;R̄&lt;/i&gt;&lt;sub&gt;10&lt;/sub&gt;(&lt;i&gt;t&lt;/i&gt;)]&lt;br&gt;int8 → 8 B + 1 seq. byte&lt;br&gt;same for all nodes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="970" y="345" width="160" height="95" as="geometry"/></mxCell>
<mxCell id="twin" value="&lt;b&gt;Box-model twin&lt;/b&gt;&lt;br&gt;cloud copy of node &lt;i&gt;i&lt;/i&gt;'s&lt;br&gt;box model, run on its uploads&lt;br&gt;→ &lt;i&gt;ŷ&lt;/i&gt;&lt;sup&gt;twin&lt;/sup&gt; ∈ ℝ&lt;sup&gt;6&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#FBE3E2;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1370" y="345" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="trg" value="&lt;b&gt;⑨ Event trigger&lt;/b&gt;&lt;br&gt;send if ‖&lt;i&gt;ŷ&lt;/i&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;sub&gt;1:3&lt;/sub&gt; − &lt;i&gt;ŷ&lt;/i&gt;&lt;sup&gt;twin&lt;/sup&gt;‖ ∈ top 20 %&lt;br&gt;and token bucket &amp;gt; 0&lt;br&gt;(4–6 messages / node / day)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1580" y="345" width="200" height="95" as="geometry"/></mxCell>
<mxCell id="sens" value="&lt;b&gt;① Sensors&lt;/b&gt;&lt;br&gt;(hourly means)&lt;br&gt;&lt;br&gt;PMS7003 (PM)&lt;br&gt;MQ-7 (CO)&lt;br&gt;SGP41 (VOC/NOx)&lt;br&gt;HDC1080 (T, RH)&lt;br&gt;BMP280 (p)&lt;br&gt;2 fans (wind)&lt;br&gt;rain, BH1750, DS3231&lt;br&gt;&lt;br&gt;&lt;i&gt;S&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;) ∈ ℝ&lt;sup&gt;23&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#F5F5F5;gradientColor=#DDDDDD;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="585" width="150" height="275" as="geometry"/></mxCell>
<mxCell id="ctx" value="&lt;b&gt;Context&lt;/b&gt; &lt;i&gt;c&lt;/i&gt;&lt;sub&gt;ctx&lt;/sub&gt; ∈ ℝ&lt;sup&gt;9&lt;/sup&gt;&lt;br&gt;raw values at hour &lt;i&gt;t&lt;/i&gt; that&lt;br&gt;instance norm removes:&lt;br&gt;ln PM2.5, RH, T, CO,&lt;br&gt;hour, season (sin/cos), wind" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="600" y="585" width="170" height="100" as="geometry"/></mxCell>
<mxCell id="cS" value="⑤ Node state (on device, 0 extra link bytes)" style="rounded=0;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#2F6F62;fillColor=#E8F5F1;strokeColor=#4A9A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="785" y="562" width="525" height="133" as="geometry"/></mxCell>
<mxCell id="cons" value="&lt;b&gt;Consensus level&lt;/b&gt;&lt;br&gt;&lt;i&gt;d&lt;/i&gt; = &lt;i&gt;R̄&lt;/i&gt; + EWMA&lt;sub&gt;24 h&lt;/sub&gt;(&lt;i&gt;S&lt;/i&gt; − &lt;i&gt;R̄&lt;/i&gt;)&lt;br&gt;→ [&lt;i&gt;d&lt;/i&gt; − &lt;i&gt;S&lt;/i&gt;, Δ1h &lt;i&gt;d&lt;/i&gt;, Δ3h &lt;i&gt;d&lt;/i&gt;]&lt;br&gt;∈ ℝ&lt;sup&gt;3&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#CDEBE4;strokeColor=#4A9A8A;" vertex="1" parent="1"><mxGeometry x="795" y="585" width="160" height="100" as="geometry"/></mxCell>
<mxCell id="bin" value="&lt;b&gt;Broadcast input&lt;/b&gt;&lt;br&gt;[3&lt;i&gt;R̂&lt;/i&gt;, &lt;i&gt;R̄&lt;/i&gt;&lt;sub&gt;25&lt;/sub&gt; − &lt;i&gt;S&lt;/i&gt;&lt;sub&gt;25&lt;/sub&gt;, &lt;i&gt;R̄&lt;/i&gt;&lt;sub&gt;10&lt;/sub&gt; − &lt;i&gt;S&lt;/i&gt;&lt;sub&gt;10&lt;/sub&gt;]&lt;br&gt;&lt;i&gt;b&lt;/i&gt; ∈ ℝ&lt;sup&gt;8&lt;/sup&gt;  + age &lt;i&gt;a&lt;/i&gt; (hours)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="970" y="585" width="160" height="100" as="geometry"/></mxCell>
<mxCell id="mem" value="&lt;b&gt;Node memory&lt;/b&gt;  ★ new&lt;br&gt;&lt;i&gt;M&lt;/i&gt; ∈ ℝ&lt;sup&gt;24×2&lt;/sup&gt;: EWMA (10 days) of&lt;br&gt;&lt;i&gt;o&lt;/i&gt; = &lt;i&gt;S&lt;/i&gt; − &lt;i&gt;R̄&lt;/i&gt; per clock hour &lt;i&gt;c&lt;/i&gt;&lt;br&gt;surprise &lt;i&gt;o&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;) − &lt;i&gt;M&lt;/i&gt;(&lt;i&gt;c&lt;sub&gt;t&lt;/sub&gt;&lt;/i&gt;) ∈ ℝ&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;profile &lt;i&gt;M&lt;/i&gt;(&lt;i&gt;c&lt;sub&gt;t+h&lt;/sub&gt;&lt;/i&gt;) − &lt;i&gt;M&lt;/i&gt;(&lt;i&gt;c&lt;sub&gt;t&lt;/sub&gt;&lt;/i&gt;) ∈ ℝ&lt;sup&gt;6&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#CDEBE4;strokeColor=#1F6B5C;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1145" y="585" width="158" height="100" as="geometry"/></mxCell>
<mxCell id="cStu" value="⑥ Box model GDC-CNN (≈15k params, Keras → TFLite FP32)" style="rounded=0;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#8A2F2B;fillColor=#FDF3F2;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="215" y="725" width="1095" height="148" as="geometry"/></mxCell>
<mxCell id="win" value="&lt;b&gt;Input window&lt;/b&gt;&lt;br&gt;&lt;i&gt;X&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; ∈ ℝ&lt;sup&gt;24×23&lt;/sup&gt;&lt;br&gt;instance norm per&lt;br&gt;feature over 24 h;&lt;br&gt;keeps scale &lt;i&gt;s&lt;/i&gt; ∈ ℝ&lt;sup&gt;6&lt;/sup&gt; (σ of ln PM)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="230" y="752" width="150" height="110" as="geometry"/></mxCell>
<mxCell id="pat" value="&lt;b&gt;Patch + embed&lt;/b&gt;&lt;br&gt;12 patches × 2 h&lt;br&gt;→ ℝ&lt;sup&gt;12×46&lt;/sup&gt;&lt;br&gt;Dense 46→32&lt;br&gt;+ position code&lt;br&gt;→ ℝ&lt;sup&gt;12×32&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="410" y="752" width="160" height="110" as="geometry"/></mxCell>
<mxCell id="gdc" value="&lt;b&gt;3 × GDC block&lt;/b&gt; (dil. 1, 2, 4)&lt;br&gt;LN → causal depthwise&lt;br&gt;conv &lt;i&gt;k&lt;/i&gt; = 3 → Dense 64&lt;br&gt;→ GLU → Dense 32&lt;br&gt;+ residual → ℝ&lt;sup&gt;12×32&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="600" y="752" width="170" height="110" as="geometry"/></mxCell>
<mxCell id="join" value="&lt;b&gt;Join + head&lt;/b&gt;&lt;br&gt;flatten ℝ&lt;sup&gt;12×32&lt;/sup&gt; → ℝ&lt;sup&gt;384&lt;/sup&gt;  ‖  &lt;i&gt;φ&lt;/i&gt;(&lt;i&gt;c&lt;/i&gt;&lt;sub&gt;ctx&lt;/sub&gt;), &lt;i&gt;φ&lt;/i&gt;(cons.), &lt;i&gt;φ&lt;/i&gt;(&lt;i&gt;b&lt;/i&gt;), &lt;i&gt;φ&lt;/i&gt;(mem.),  each &lt;i&gt;φ&lt;/i&gt; = Dense 32 + GELU&lt;br&gt;concat → ℝ&lt;sup&gt;512&lt;/sup&gt; → Dense 512→6 → ⊙ &lt;i&gt;s&lt;/i&gt;&lt;br&gt;local correction  &lt;i&gt;s&lt;/i&gt; ⊙ &lt;i&gt;c&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; ∈ ℝ&lt;sup&gt;6&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="800" y="752" width="500" height="110" as="geometry"/></mxCell>
<mxCell id="plus" value="+" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=20;fontColor=#111111;fillColor=#FFFFFF;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="1330" y="785" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="plusT" value="⑦ &lt;i&gt;ŷ&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; = &lt;i&gt;R̂&lt;/i&gt; + &lt;i&gt;s&lt;/i&gt; ⊙ &lt;i&gt;c&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; ∈ ℝ&lt;sup&gt;6&lt;/sup&gt;" style="text;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1300" y="832" width="104" height="36" as="geometry"/></mxCell>
<mxCell id="age" value="&lt;b&gt;Age switch&lt;/b&gt; (planned, E12)&lt;br&gt;&lt;i&gt;a&lt;/i&gt; ≤ 1 h → &lt;i&gt;ŷ&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;a&lt;/i&gt; &amp;gt; 1 h or missing →&lt;br&gt;box-alone model &lt;i&gt;ŷ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;&lt;sup&gt;ctx&lt;/sup&gt;&lt;br&gt;(both models in flash)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;" vertex="1" parent="1"><mxGeometry x="1400" y="752" width="170" height="110" as="geometry"/></mxCell>
<mxCell id="scr" value="&lt;b&gt;⑧ Fusion &amp;amp; display&lt;/b&gt;&lt;br&gt;fresh personal → &lt;i&gt;ŷ&lt;/i&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;br&gt;age 1–3 h → &lt;i&gt;α&lt;sub&gt;a&lt;/sub&gt;ŷ&lt;/i&gt;&lt;sup&gt;T&lt;/sup&gt; + (1−&lt;i&gt;α&lt;sub&gt;a&lt;/sub&gt;&lt;/i&gt;)&lt;i&gt;ŷ&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;&lt;br&gt;(&lt;i&gt;α&lt;/i&gt; = .52/.41/.36, path re-based)&lt;br&gt;else → &lt;i&gt;ŷ&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;&lt;br&gt;PM = e&lt;sup&gt;ln(1+PM&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt;)+&lt;i&gt;ŷ&lt;/i&gt;&lt;/sup&gt; − 1 → CPCB AQI" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#F5F5F5;gradientColor=#E6E6E6;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1600" y="740" width="180" height="130" as="geometry"/></mxCell>
<mxCell id="laneT" value="TRAINING ONLY — true CPCB PM (&lt;i&gt;Y&lt;/i&gt;) is used here only as a target; nothing in this region runs at inference" style="rounded=0;html=1;fontFamily=Times New Roman;fontSize=14;fontStyle=1;fontColor=#6A4C93;fillColor=#FBF8FD;strokeColor=#9673A6;dashed=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="905" width="1780" height="200" as="geometry"/></mxCell>
<mxCell id="ty" value="&lt;b&gt;Reference &lt;i&gt;Y&lt;/i&gt;&lt;/b&gt;&lt;br&gt;CPCB hourly PM,&lt;br&gt;32 stations,&lt;br&gt;2018 – Sep 2026" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="140" height="90" as="geometry"/></mxCell>
<mxCell id="sA" value="&lt;b&gt;Stage A — data + simulator&lt;/b&gt;&lt;br&gt;simulator.py: 3 virtual boxes / station&lt;br&gt;grids ℝ&lt;sup&gt;hours×32×23&lt;/sup&gt; per unit + ERA5&lt;br&gt;train 2018–23 · val 2024 · test 2025–26&lt;br&gt;5 stations never trained on&lt;br&gt;target &lt;i&gt;y&lt;/i&gt; = ln(1+PM&lt;sub&gt;&lt;i&gt;t+h&lt;/i&gt;&lt;/sub&gt;) − ln(1+PM&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="210" y="950" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="sB1" value="&lt;b&gt;Stage B1 — cloud graph model&lt;/b&gt; (T4 GPU) → deployed to ③b&lt;br&gt;&lt;i&gt;L&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; = Huber(&lt;i&gt;ŷ&lt;/i&gt;&lt;sup&gt;T&lt;/sup&gt;, &lt;i&gt;y&lt;/i&gt;) + 0.5 · pinball(&lt;i&gt;q&lt;/i&gt;&lt;sub&gt;10&lt;/sub&gt;, &lt;i&gt;q&lt;/i&gt;&lt;sub&gt;90&lt;/sub&gt;)&lt;br&gt;AdamW 1e-3, batch 64, node dropout 0.1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="510" y="935" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="sB2" value="&lt;b&gt;Stage B2 — regional forecaster&lt;/b&gt; (CPU) → deployed to ③a&lt;br&gt;target: node-mean of &lt;i&gt;y&lt;/i&gt;; 3 folds of 2 years&lt;br&gt;→ out-of-fold &lt;i&gt;R̂&lt;/i&gt; for every training hour" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="510" y="1020" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="sC" value="&lt;b&gt;Stage C — box model&lt;/b&gt; (Kaggle) → flashed to ⑥&lt;br&gt;inputs: simulated box readings + out-of-fold &lt;i&gt;R̂&lt;/i&gt;&lt;br&gt;&lt;i&gt;L&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt; = Huber(&lt;i&gt;ŷ&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;, &lt;i&gt;y&lt;/i&gt;)  [+ optional cloud matching to &lt;i&gt;ŷ&lt;/i&gt;&lt;sup&gt;T&lt;/sup&gt;]&lt;br&gt;≥ 1 M windows, 3 seeds, early stop on 2024&lt;br&gt;Keras → TFLite FP32 → student_model.h" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="910" y="950" width="340" height="120" as="geometry"/></mxCell>
<mxCell id="sD" value="&lt;b&gt;Evaluation&lt;/b&gt; (test Jan 2025 – Sep 2026; skill = 1 − RMSE/RMSE&lt;sub&gt;persistence&lt;/sub&gt;, %)&lt;br&gt;&lt;table style=&quot;font-size:11px;margin:2px auto 0 auto&quot;&gt;&lt;tr&gt;&lt;td align=&quot;left&quot;&gt;on-device model&lt;/td&gt;&lt;td&gt;&amp;nbsp;27 seen&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;5 unseen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;left&quot;&gt;box alone (ctx)&lt;/td&gt;&lt;td&gt;16.0&lt;/td&gt;&lt;td&gt;17.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;left&quot;&gt;+ broadcast, residual output&lt;/td&gt;&lt;td&gt;17.7&lt;/td&gt;&lt;td&gt;19.9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;left&quot;&gt;+ consensus level&lt;/td&gt;&lt;td&gt;18.0&lt;/td&gt;&lt;td&gt;20.3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;left&quot;&gt;&lt;b&gt;+ node memory ★&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;18.9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;21.1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;week-block paired bootstrap CI; cloud graph model T1 (+1..+6 h): 26.0" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=11;fontColor=#111111;fillColor=#FFFFFF;strokeColor=#111111;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1290" y="925" width="490" height="170" as="geometry"/></mxCell>
