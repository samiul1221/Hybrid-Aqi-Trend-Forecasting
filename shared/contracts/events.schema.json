{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aqi-hybrid.dev/v1/events.schema.json",
  "title": "POST /api/v1/events request (edge -> cloud, immediate) [S16.6]",
  "description": "Idempotent on (node_id, event_id). Evidence fields depend on the event type; known ones are typed, others allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "event_id", "type", "status", "ts_detected", "base_ts", "severity", "evidence", "fw_version", "model_version"],
  "properties": {
    "node_id": {"$ref": "common.schema.json#/$defs/node_id"},
    "event_id": {"$ref": "common.schema.json#/$defs/uuid4"},
    "type": {"enum": ["local_event", "sensor_check", "pm_sensor_fault"]},
    "status": {"enum": ["open", "update", "closed"]},
    "ts_detected": {"$ref": "common.schema.json#/$defs/ts"},
    "base_ts": {"$ref": "common.schema.json#/$defs/ts_bucket"},
    "severity": {"enum": ["low", "medium", "high"]},
    "evidence": {
      "type": "object",
      "properties": {
        "edge_aqi": {"type": "array", "items": {"type": ["integer", "null"]}, "maxItems": 3},
        "cloud_aqi": {"type": "array", "items": {"type": "integer"}, "maxItems": 3},
        "cloud_lower": {"type": "array", "items": {"type": "integer"}, "maxItems": 3},
        "cloud_upper": {"type": "array", "items": {"type": "integer"}, "maxItems": 3},
        "horizons_outside": {"type": "integer", "minimum": 0, "maximum": 3},
        "sraw_nox_z": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "pm25_max_minute": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "pm25_hour_mean": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "mq7_delta_sigma": {"$ref": "common.schema.json#/$defs/num_or_null"}
      }
    },
    "fw_version": {"type": "string"},
    "model_version": {"type": "string"}
  }
}
