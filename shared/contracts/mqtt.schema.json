{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aqi-hybrid.dev/v1/mqtt.schema.json",
  "title": "MQTT downlink/presence payloads [S16.7]. Forecast payload = forecast.schema.json (byte-identical to GET).",
  "$defs": {
    "manifest_notify": {
      "description": "topic aqi/v1/nodes/{node_id}/manifest, QoS1, retained",
      "type": "object",
      "required": ["manifest_version", "manifest_etag"],
      "properties": {"manifest_version": {"type": "integer", "minimum": 1}, "manifest_etag": {"type": "string"}}
    },
    "command": {
      "description": "topic aqi/v1/nodes/{node_id}/command, QoS1, not retained; idempotent by id",
      "type": "object",
      "required": ["cmd", "id", "args"],
      "properties": {
        "cmd": {"enum": ["upload_now", "sync_time", "rollback_model", "reboot", "recheck_manifest"]},
        "id": {"$ref": "common.schema.json#/$defs/uuid4"},
        "args": {"type": "object"}
      }
    },
    "status": {
      "description": "topic aqi/v1/nodes/{node_id}/status, QoS1, retained; offline payload is the LWT",
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "fw", "models", "ts"],
          "properties": {
            "state": {"const": "online"},
            "fw": {"type": "string"},
            "models": {"type": "object"},
            "ts": {"$ref": "common.schema.json#/$defs/ts"}
          }
        },
        {
          "type": "object",
          "required": ["state"],
          "properties": {"state": {"const": "offline"}},
          "additionalProperties": false
        }
      ]
    }
  }
}
