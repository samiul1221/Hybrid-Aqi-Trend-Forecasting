{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aqi-hybrid.dev/v1/manifest.schema.json",
  "title": "GET /api/v1/manifest 200 response (cloud -> edge) [S16.4], OTA [S18]",
  "description": "Open for additions. Edge verifies sha256 and schema_hash of every artifact before activation.",
  "type": "object",
  "required": ["manifest_version", "schema", "calibration", "models", "active", "rollout", "config"],
  "properties": {
    "manifest_version": {"type": "integer", "minimum": 1},
    "schema": {
      "type": "object",
      "required": ["version", "hash", "url", "sha256"],
      "properties": {
        "version": {"type": "integer"},
        "hash": {"$ref": "common.schema.json#/$defs/sha256_tagged"},
        "url": {"type": "string"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256_hex"}
      }
    },
    "calibration": {
      "type": "object",
      "required": ["version", "url", "sha256"],
      "properties": {
        "version": {"type": "string"},
        "url": {"type": "string"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256_hex"}
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "arch", "version", "schema_hash", "url", "sha256", "size"],
        "properties": {
          "role": {"$ref": "common.schema.json#/$defs/role"},
          "arch": {"$ref": "common.schema.json#/$defs/arch"},
          "version": {"type": "string"},
          "schema_hash": {"$ref": "common.schema.json#/$defs/sha256_tagged"},
          "url": {"type": "string"},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256_hex"},
          "size": {"type": "integer", "minimum": 0},
          "arena_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "active": {
      "type": "object",
      "required": ["A", "B"],
      "properties": {"A": {"$ref": "common.schema.json#/$defs/arch"}, "B": {"$ref": "common.schema.json#/$defs/arch"}}
    },
    "rollout": {
      "type": "object",
      "required": ["cohort", "percent"],
      "properties": {"cohort": {"enum": ["canary", "stable", "all"]}, "percent": {"type": "number", "minimum": 0, "maximum": 100}}
    },
    "config": {
      "type": "object",
      "properties": {
        "trend_threshold": {"type": "number"},
        "R_dust": {"type": "number"},
        "alerts_enabled": {"type": "boolean"}
      }
    }
  }
}
