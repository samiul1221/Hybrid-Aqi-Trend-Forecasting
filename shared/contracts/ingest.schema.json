{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aqi-hybrid.dev/v1/ingest.schema.json",
  "title": "POST /api/v1/ingest request (edge -> cloud) [S16.2]",
  "description": "Strict: unknown fields rejected so edge/cloud drift is caught in contract tests. Value ranges are NOT enforced here; cloud nulls out-of-range values and flags them [C06].",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "fw_version", "schema_hash", "pipeline_version", "calibration_version", "records"],
  "properties": {
    "node_id": {"$ref": "common.schema.json#/$defs/node_id"},
    "fw_version": {"type": "string"},
    "schema_hash": {"$ref": "common.schema.json#/$defs/sha256_tagged"},
    "pipeline_version": {"type": "string"},
    "calibration_version": {"type": "string"},
    "records": {"type": "array", "minItems": 1, "maxItems": 48, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ts", "raw", "proc", "flags", "pm_state", "events", "sys"],
      "properties": {
        "ts": {"$ref": "common.schema.json#/$defs/ts_bucket"},
        "raw": {"$ref": "#/$defs/raw"},
        "proc": {"$ref": "#/$defs/proc"},
        "flags": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z0-9_]+$"},
          "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/flag"}}
        },
        "pm_state": {"$ref": "common.schema.json#/$defs/pm_state"},
        "edge_fc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/edge_fc"}]},
        "cloud_fc_used": {
          "type": "object",
          "additionalProperties": false,
          "required": ["based_on_ts", "source"],
          "properties": {
            "based_on_ts": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/ts_bucket"}]},
            "source": {"enum": ["cloud", "cloud (stale ≤2h)", "edge (fallback)"]}
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_event", "sensor_check", "alerts"],
          "properties": {
            "local_event": {"type": "boolean"},
            "sensor_check": {"type": "boolean"},
            "alerts": {"type": "array", "items": {"type": "string"}}
          }
        },
        "sys": {
          "type": "object",
          "description": "Diagnostics; open for additions",
          "properties": {
            "heap_free": {"type": "integer"},
            "psram_free": {"type": "integer"},
            "arena_used": {"$ref": "common.schema.json#/$defs/int_or_null"},
            "rssi": {"type": "integer"},
            "uptime_s": {"type": "integer"},
            "energy_mJ": {"$ref": "common.schema.json#/$defs/num_or_null"},
            "last_command_id": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/uuid4"}], "description": "[S16.7] command acknowledgement"}
          }
        }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pm1", "pm25", "pm4", "pm10", "t", "rh", "p", "lux", "wind_u", "wind_v", "wind_speed", "wind_dir", "rain_frac", "mq7_rs", "mq135_rs", "sraw_voc", "sraw_nox"],
      "properties": {
        "pm1": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "pm25": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "pm4": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "pm10": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "typ_size_um": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "t": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "rh": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "p": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "lux": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "wind_u": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "wind_v": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "wind_speed": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "wind_dir": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "rain_frac": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "mq7_rs": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "mq135_rs": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "sraw_voc": {"$ref": "common.schema.json#/$defs/int_or_null"},
        "sraw_nox": {"$ref": "common.schema.json#/$defs/int_or_null"},
        "pm25_max_minute": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "sraw_nox_max_minute": {"$ref": "common.schema.json#/$defs/int_or_null"}
      }
    },
    "proc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pm25_corr", "pm10_corr", "coarse_ratio", "dust", "aqi_pm", "aqi_valid_hours", "kappa", "baselines"],
      "properties": {
        "pm25_corr": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "pm10_corr": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "coarse_ratio": {"$ref": "common.schema.json#/$defs/num_or_null"},
        "dust": {"type": "boolean"},
        "aqi_pm": {"$ref": "common.schema.json#/$defs/int_or_null", "description": "null = not_ready"},
        "aqi_valid_hours": {"type": "integer", "minimum": 0, "maximum": 24},
        "kappa": {"type": "number"},
        "baselines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Rbase7", "Rbase135", "base_voc", "base_nox"],
          "properties": {
            "Rbase7": {"$ref": "common.schema.json#/$defs/num_or_null"},
            "Rbase135": {"$ref": "common.schema.json#/$defs/num_or_null"},
            "base_voc": {"$ref": "common.schema.json#/$defs/num_or_null"},
            "base_nox": {"$ref": "common.schema.json#/$defs/num_or_null"}
          }
        }
      }
    },
    "edge_fc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_version", "y", "pm25", "pm10", "aqi", "trend", "inference_ms"],
      "properties": {
        "model": {"$ref": "common.schema.json#/$defs/model_used"},
        "model_version": {"type": "string"},
        "y": {"$ref": "common.schema.json#/$defs/numbers6", "description": "[pm25_h1..h3, pm10_h1..h3]"},
        "pm25": {"$ref": "common.schema.json#/$defs/numbers3"},
        "pm10": {"$ref": "common.schema.json#/$defs/numbers3"},
        "aqi": {"type": "array", "items": {"type": ["integer", "null"]}, "minItems": 3, "maxItems": 3},
        "trend": {"$ref": "common.schema.json#/$defs/trend"},
        "inference_ms": {"type": "number", "minimum": 0}
      }
    }
  }
}
