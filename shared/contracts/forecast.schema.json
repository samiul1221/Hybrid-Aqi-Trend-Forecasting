{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aqi-hybrid.dev/v1/forecast.schema.json",
  "title": "Cloud forecast (GET /api/v1/forecast 200 and MQTT aqi/v1/nodes/{id}/forecast) [S16.3], [C14.2]",
  "description": "Cloud -> edge. Open: edge MUST ignore unknown fields [C14.1]. Arrays are h=1..6; edge uses h=1..3. Edge rejects based_on_ts in the future [S17] C14.",
  "type": "object",
  "required": ["node_id", "based_on_ts", "issued_at", "teacher_version", "node_inputs_complete", "horizons", "y", "y10", "pm25", "pm10", "aqi", "aqi_lower", "aqi_upper", "interval_coverage_target", "interval_quality"],
  "properties": {
    "node_id": {"$ref": "common.schema.json#/$defs/node_id"},
    "based_on_ts": {"$ref": "common.schema.json#/$defs/ts_bucket"},
    "issued_at": {"$ref": "common.schema.json#/$defs/ts"},
    "teacher_version": {"type": "string"},
    "forecast_source": {"enum": ["teacher", "persistence_fallback"]},
    "node_inputs_complete": {"type": "boolean"},
    "horizons": {"const": [1, 2, 3, 4, 5, 6]},
    "y": {"$ref": "common.schema.json#/$defs/numbers6", "description": "PM2.5 log-change h1..h6"},
    "y10": {"$ref": "common.schema.json#/$defs/numbers6", "description": "PM10 log-change h1..h6"},
    "pm25": {"$ref": "common.schema.json#/$defs/numbers6"},
    "pm10": {"$ref": "common.schema.json#/$defs/numbers6"},
    "aqi": {"$ref": "common.schema.json#/$defs/ints6"},
    "aqi_lower": {"$ref": "common.schema.json#/$defs/ints6"},
    "aqi_upper": {"$ref": "common.schema.json#/$defs/ints6"},
    "interval_coverage_target": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "interval_quality": {"$ref": "common.schema.json#/$defs/interval_quality"},
    "trend": {"$ref": "common.schema.json#/$defs/trend"},
    "gas_subindex": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["station", "station_ts"],
          "properties": {
            "no2": {"$ref": "common.schema.json#/$defs/num_or_null"},
            "o3": {"$ref": "common.schema.json#/$defs/num_or_null"},
            "co": {"$ref": "common.schema.json#/$defs/num_or_null"},
            "station": {"type": "string"},
            "station_ts": {"$ref": "common.schema.json#/$defs/ts"}
          }
        }
      ],
      "description": "omitted/null when CPCB feed is down [S17] C13"
    },
    "neighbour_pm_estimate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["pm25", "pm10", "valid"],
          "properties": {
            "pm25": {"$ref": "common.schema.json#/$defs/num_or_null"},
            "pm10": {"$ref": "common.schema.json#/$defs/num_or_null"},
            "valid": {"type": "boolean"}
          }
        }
      ]
    },
    "updates": {"type": "object", "properties": {"manifest_etag": {"type": "string"}}}
  }
}
